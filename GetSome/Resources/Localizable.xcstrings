        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以上です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 전부입니다."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "就这些了。"
          }
        }
      }
    },
