    "%lld request(s) returned a page this app didn’t recognise": {
      "comment": "A label that highlights a number of requests that returned a page the app didn’t recognise.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Anfrage(n) haben eine Seite zurückgegeben, die diese App nicht erkannt hat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld requête(s) ont renvoyé une page que cette app n’a pas reconnue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld अनुरोध(ों) से ऐसा पेज मिला जिसे यह ऐप नहीं पहचान सका"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のリクエストで、このAppが認識できないページが返されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 요청에서 이 앱이 인식하지 못한 페이지가 반환되었습니다"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个请求返回了此 App 无法识别的页面"
          }
        }
      }
    },
    "A record of recent requests, for reporting a feed that stopped working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Protokoll der letzten Anfragen, um einen nicht mehr funktionierenden Feed zu melden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un historique des requêtes récentes, pour signaler un flux qui ne fonctionne plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल के अनुरोधों का रिकॉर्ड, ताकि बंद हो चुकी फ़ीड की शिकायत की जा सके।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のリクエストの記録です。動作しなくなったフィードを報告するときに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동을 멈춘 피드를 신고할 때 사용하는 최근 요청 기록입니다."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "近期请求的记录，用于反馈已失效的内容源。"
          }
        }
      }
    },
    "A wider mix, pulled from across the catalog.": {
      "comment": "The description of a collection of videos.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine größere Auswahl aus dem gesamten Katalog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix plus large, puisé dans tout le catalogue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे कैटलॉग से लिया गया व्यापक मिश्रण।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログ全体から集めた、より幅広い作品。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그 전체에서 모은 더 폭넓은 목록."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从整个片库中挑选的更广泛内容。"
          }
        }
      }
    },
    "About": {
      "comment": "A section in the profile view that shows information about the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        },
        "fr": {
