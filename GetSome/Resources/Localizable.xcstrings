{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ answered, but this app didn’t recognize anything on the page. The site has probably changed. Profile › Diagnostics can export what it sent.": {
      "comment": "An error shown when a site's markup no longer parses",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat geantwortet, aber diese App hat auf der Seite nichts erkannt. Wahrscheinlich hat sich die Website geändert. Unter Profil › Diagnose lässt sich exportieren, was gesendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondió, pero esta app no reconoció nada en la página. Es probable que el sitio haya cambiado. En Perfil › Diagnóstico puedes exportar lo que se envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a répondu, mais cette app n’a rien reconnu sur la page. Le site a probablement changé. Profil › Diagnostics permet d’exporter ce qui a été envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने जवाब दिया, लेकिन यह ऐप पेज पर कुछ भी नहीं पहचान सका। संभवतः साइट बदल गई है। प्रोफ़ाइल › डायग्नोस्टिक्स से भेजी गई सामग्री निर्यात की जा सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha risposto, ma questa app non ha riconosciuto nulla nella pagina. Probabilmente il sito è cambiato. In Profilo › Diagnostica puoi esportare ciò che è stato inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がありましたが、ページ内で認識できるものがありませんでした。サイトが変更された可能性があります。プロフィール › 診断 から送信内容を書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답했지만 이 앱이 페이지에서 아무것도 인식하지 못했습니다. 사이트가 변경된 것 같습니다. 프로필 › 진단에서 전송한 내용을 내보낼 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondeu, mas esta app não reconheceu nada na página. O site provavelmente mudou. Em Perfil › Diagnóstico pode exportar o que foi enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ответил, но это приложение ничего не распознало на странице. Скорее всего, сайт изменился. В разделе «Профиль › Диагностика» можно выгрузить отправленные данные."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有响应，但此 App 未能识别页面上的任何内容。该网站可能已更改。可在“个人资料 › 诊断”中导出所发送的内容。"
          }
        }
      }
    },
    "%@ doesn’t publish a category list.": {
      "comment": "A description of the content unavailable view in the categories view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
