    "%@ is asking for a CAPTCHA before it will accept a sign-in. This app can’t complete one — sign in on the site in a browser, then try again." : {
      "comment" : "An error shown when a site demands a CAPTCHA to sign in",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlangt ein CAPTCHA, bevor die Anmeldung akzeptiert wird. Diese App kann keines lösen — im Browser auf der Website anmelden und es dann erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pide un CAPTCHA antes de aceptar el inicio de sesión. Esta app no puede completarlo: inicie sesión en el sitio desde un navegador y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande un CAPTCHA avant d’accepter la connexion. Cette app ne peut pas le remplir — connectez-vous au site dans un navigateur, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ साइन इन स्वीकार करने से पहले CAPTCHA माँग रहा है। यह ऐप उसे पूरा नहीं कर सकता — ब्राउज़र में साइट पर साइन इन करें, फिर दोबारा कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ richiede un CAPTCHA prima di accettare l’accesso. Questa app non può completarlo: accedi al sito da un browser e poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はサインインを受け付ける前に CAPTCHA を求めています。このアプリでは完了できないため、ブラウザでサイトにサインインしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그인을 수락하기 전에 CAPTCHA를 요구합니다. 이 앱에서는 완료할 수 없으므로 브라우저에서 사이트에 로그인한 다음 다시 시도하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está a pedir um CAPTCHA antes de aceitar o início de sessão. Esta app não consegue completá-lo — inicie sessão no site num navegador e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ требует CAPTCHA, прежде чем принять вход. Это приложение не может её пройти — войдите на сайт в браузере, а затем повторите попытку."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求先完成 CAPTCHA 验证才接受登录。此 App 无法完成验证——请在浏览器中登录该网站，然后重试。"
          }
        }
      }
    },
    "%@ is refusing requests from this app at the moment. It will be tried again shortly." : {
      "comment" : "An error shown when a site has started refusing requests",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ weigert sich momentan, Anfragen von dieser App zu akzeptieren. Es wird bald erneut versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está rechazando las solicitudes de esta app en este momento. Se volverá a intentar en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ refuse actuellement les demandes de cette app. Une nouvelle tentative sera effectuée bientôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इस समय इस ऐप से अनुरोधों को अस्वीकार कर रहा है। इसे शीघ्र ही फिर से आजमाया जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sta rifiutando le richieste di questa app al momento. Verrà riprovato tra breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は現在このアプリからのリクエストを拒否しています。間もなく再度試行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 현재 이 앱의 요청을 거부하고 있습니다. 곧 다시 시도됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está recusando solicitações deste app no momento. Será tentado novamente em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сейчас отказывает в запросах от этого приложения. Попытка будет повторена вскоре."
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前拒绝来自此应用的请求。将在稍后再次尝试。"
          }
        }
      }
    },
