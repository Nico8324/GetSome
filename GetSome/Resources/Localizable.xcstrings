    "%lld request(s) returned a page this app didn’t recognise": {
      "comment": "A label that highlights a number of requests that returned a page the app didn’t recognise.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Anfrage(n) haben eine Seite zurückgegeben, die diese App nicht erkannt hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld solicitud(es) devolvieron una página que esta app no reconoció"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld requête(s) ont renvoyé une page que cette app n’a pas reconnue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld अनुरोध(ों) से ऐसा पेज मिला जिसे यह ऐप नहीं पहचान सका"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld richiesta/e hanno restituito una pagina che questa app non ha riconosciuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のリクエストで、このAppが認識できないページが返されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 요청에서 이 앱이 인식하지 못한 페이지가 반환되었습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pedido(s) devolveram uma página que esta app não reconheceu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld запрос(ов) вернули страницу, которую это приложение не распознало"
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个请求返回了此 App 无法识别的页面"
          }
        }
      }
    },
    "A record of recent requests, for reporting a feed that stopped working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Protokoll der letzten Anfragen, um einen nicht mehr funktionierenden Feed zu melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro de las solicitudes recientes, para informar de un canal que dejó de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un historique des requêtes récentes, pour signaler un flux qui ne fonctionne plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल के अनुरोधों का रिकॉर्ड, ताकि बंद हो चुकी फ़ीड की शिकायत की जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro delle richieste recenti, per segnalare un feed che ha smesso di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のリクエストの記録です。動作しなくなったフィードを報告するときに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동을 멈춘 피드를 신고할 때 사용하는 최근 요청 기록입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um registo dos pedidos recentes, para comunicar um canal que deixou de funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал последних запросов — чтобы сообщить о ленте, которая перестала работать."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "近期请求的记录，用于反馈已失效的内容源。"
          }
        }
      }
    },
    "A wider mix, pulled from across the catalog.": {
      "comment": "The description of a collection of videos.",
      "localizations": {
        "de": {
