    "Titles and keywords are sent to Google Translate to be translated. Text already in %@ never leaves this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel und Stichwörter werden zum Übersetzen an Google Übersetzer gesendet. Text, der bereits auf %@ ist, verlässt dieses Gerät nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos y las palabras clave se envían a Google Traductor para traducirlos. El texto que ya está en %@ nunca sale de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres et les mots-clés sont envoyés à Google Traduction. Le texte déjà en %@ ne quitte jamais cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक और कीवर्ड अनुवाद के लिए Google अनुवाद को भेजे जाते हैं। जो पाठ पहले से %@ में है, वह कभी इस डिवाइस से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli e parole chiave vengono inviati a Google Traduttore per la traduzione. Il testo già in %@ non lascia mai questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルとキーワードは翻訳のため Google 翻訳に送信されます。すでに%@のテキストがこのデバイスから送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목과 키워드는 번역을 위해 Google 번역으로 전송됩니다. 이미 %@(으)로 된 텍스트는 이 기기를 벗어나지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos e as palavras-chave são enviados para o Google Tradutor. O texto que já está em %@ nunca sai deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия и ключевые слова отправляются в Google Переводчик. Текст, уже написанный на %@, никогда не покидает это устройство."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "标题和关键词会发送至 Google 翻译进行翻译。已经是%@的文本绝不会离开此设备。"
          }
        }
      }
    },
