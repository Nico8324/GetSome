    "%@ sent this request to its home page instead of the feed. That usually means the site doesn’t serve this content where you are.": {
      "comment": "An error shown when a site redirects every request to its home page",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diese Anfrage auf die Startseite geleitet statt auf den Feed. Das bedeutet meist, dass die Website diese Inhalte an deinem Standort nicht anbietet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envió esta solicitud a su página principal en lugar de al canal. Normalmente eso significa que el sitio no ofrece este contenido donde estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a redirigé cette requête vers sa page d’accueil au lieu du flux. Cela signifie généralement que le site ne propose pas ce contenu là où vous êtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने इस अनुरोध को फ़ीड के बजाय अपने होम पेज पर भेज दिया। आमतौर पर इसका अर्थ है कि साइट आपके क्षेत्र में यह सामग्री उपलब्ध नहीं कराती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha indirizzato questa richiesta alla propria home page invece che al feed. Di solito significa che il sito non offre questo contenuto dove ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのリクエストをフィードではなくホームページに転送しました。通常、これはお住まいの地域でこのコンテンツが提供されていないことを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 요청을 피드가 아닌 홈페이지로 보냈습니다. 보통 현재 위치에서 이 콘텐츠를 제공하지 않는다는 뜻입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enviou este pedido para a página inicial em vez do canal. Normalmente isso significa que o site não disponibiliza este conteúdo onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ перенаправил этот запрос на главную страницу вместо ленты. Обычно это значит, что сайт не показывает этот контент в вашем регионе."
          }
        },
        "zh_CN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将此请求转到了首页而不是内容源。这通常表示该网站不在你所在的地区提供此内容。"
          }
        }
      }
    },
