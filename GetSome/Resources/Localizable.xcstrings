    "Locking asks for age confirmation again before showing anything.": {
      "comment": "A description of the lock button.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sperren wird vor der Anzeige erneut nach der Altersbestätigung gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al bloquear se pedirá de nuevo la confirmación de edad antes de mostrar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage redemande la confirmation d’âge avant d’afficher quoi que ce soit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक करने पर कुछ भी दिखाने से पहले दोबारा आयु पुष्टि माँगी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccando, la conferma dell’età verrà richiesta di nuovo prima di mostrare qualsiasi contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックすると、表示する前に年齢確認をもう一度求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠그면 내용을 표시하기 전에 연령 확인을 다시 요청합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao bloquear, será pedida novamente a confirmação de idade antes de mostrar qualquer coisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После блокировки подтверждение возраста будет запрошено снова, прежде чем что-либо показать."
